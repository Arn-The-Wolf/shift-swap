<% content_for :title, "Dashboard · Shift Swap" %>

<section class="fade-up">
  <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-lagoon"><%= current_user.team.name %></p>
      <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">Hey, <%= current_user.name.split.first %></h1>
      <p class="mt-1 text-ink-soft">Here’s what’s on your schedule.</p>
    </div>
    <%= link_to new_swap_request_path, class: "btn-primary" do %>
      Request a swap
      <span class="loader-dots hidden" data-loading-indicator aria-hidden="true"><span></span><span></span><span></span></span>
    <% end %>
  </div>

  <div class="panel">
    <h2 class="font-display text-xl font-semibold text-ink">Upcoming shifts</h2>
    <% if @upcoming_shifts.any? %>
      <div class="mt-2">
        <% @upcoming_shifts.each do |shift| %>
          <div class="shift-row">
            <div>
              <p class="font-semibold text-ink"><%= shift.title %></p>
              <p class="text-sm text-ink-soft"><%= shift.duration_label %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-ink-soft">No upcoming shifts yet. Ask a manager to schedule you.</p>
    <% end %>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <div class="panel">
      <h2 class="font-display text-xl font-semibold text-ink">Your outgoing requests</h2>
      <% if @pending_outgoing.any? %>
        <ul class="mt-3 space-y-3">
          <% @pending_outgoing.each do |request| %>
            <li class="rounded-xl border border-mist/80 bg-foam/60 px-3 py-3">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="font-medium text-ink"><%= request.shift.title %></p>
                  <p class="text-sm text-ink-soft">Asking <%= request.target_user.name %></p>
                </div>
                <span class="status-pending"><%= request.status %></span>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-ink-soft">No pending outgoing requests.</p>
      <% end %>
    </div>

    <div class="panel">
      <h2 class="font-display text-xl font-semibold text-ink">Incoming cover asks</h2>
      <% if @pending_incoming.any? %>
        <ul class="mt-3 space-y-3">
          <% @pending_incoming.each do |request| %>
            <li class="rounded-xl border border-mist/80 bg-foam/60 px-3 py-3">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="font-medium text-ink"><%= request.shift.title %></p>
                  <p class="text-sm text-ink-soft">From <%= request.requesting_user.name %></p>
                </div>
                <span class="status-pending"><%= request.status %></span>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-ink-soft">Nobody has asked you to cover yet.</p>
      <% end %>
    </div>
  </div>
</section>
