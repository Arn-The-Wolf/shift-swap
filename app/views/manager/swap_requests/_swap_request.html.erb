<%= turbo_frame_tag dom_id(swap_request), class: "panel block" do %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <h2 class="font-display text-xl font-semibold text-ink"><%= swap_request.shift.title %></h2>
        <span class="status-<%= swap_request.status %>"><%= swap_request.status %></span>
      </div>
      <p class="text-sm text-ink-soft"><%= swap_request.shift.duration_label %></p>
      <p class="mt-2 text-sm text-ink">
        <span class="font-semibold"><%= swap_request.requesting_user.name %></span>
        asks
        <span class="font-semibold"><%= swap_request.target_user.name %></span>
        to cover.
      </p>
    </div>

    <% if swap_request.pending? %>
      <div class="flex flex-wrap gap-2">
        <%= button_to "Approve",
              approve_manager_swap_request_path(swap_request),
              method: :patch,
              class: "btn-success",
              form: { data: { turbo_stream: true } },
              data: { turbo_submits_with: "Approving…" } %>
        <%= button_to "Deny",
              deny_manager_swap_request_path(swap_request),
              method: :patch,
              class: "btn-danger",
              form: { data: { turbo_stream: true } },
              data: { turbo_submits_with: "Denying…" } %>
      </div>
    <% end %>
  </div>
<% end %>
