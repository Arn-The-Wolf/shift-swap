<% content_for :title, "Sign up · Shift Swap" %>

<section class="mx-auto max-w-md fade-up">
  <div class="panel">
    <h1 class="font-display text-3xl font-bold text-ink">Create account</h1>
    <p class="mt-2 text-sm text-ink-soft">Join a team and start managing shifts.</p>

    <% if @user.errors.any? %>
      <div class="flash-alert mt-4">
        <ul class="list-disc pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: signup_path, class: "mt-6 space-y-4" do |f| %>
      <div>
        <%= f.label :name, class: "label" %>
        <%= f.text_field :name, required: true, class: "field", placeholder: "Alex Rivera" %>
      </div>
      <div>
        <%= f.label :email, class: "label" %>
        <%= f.email_field :email, required: true, class: "field", placeholder: "alex@cafe.com" %>
      </div>
      <div>
        <%= f.label :team_id, "Team", class: "label" %>
        <%= f.collection_select :team_id, @teams, :id, :name, { prompt: "Select a team" }, class: "field", required: true %>
      </div>
      <div>
        <%= f.label :password, class: "label" %>
        <%= f.password_field :password, required: true, class: "field", placeholder: "At least 6 characters" %>
      </div>
      <div>
        <%= f.label :password_confirmation, "Confirm password", class: "label" %>
        <%= f.password_field :password_confirmation, required: true, class: "field" %>
      </div>
      <%= f.submit "Create account",
            class: "btn-primary w-full",
            data: { turbo_submits_with: "Creating…" } %>
    <% end %>

    <p class="mt-5 text-center text-sm text-ink-soft">
      Already have an account? <%= link_to "Sign in", login_path, class: "font-semibold text-lagoon hover:text-lagoon-deep" %>
    </p>
  </div>
</section>
